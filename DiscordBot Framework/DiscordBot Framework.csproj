<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>DiscordBot_Framework</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>discordBotFramework</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="APIs.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>APIs.settings</DependentUpon>
    </Compile>
    <Compile Update="Properties\APIs.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>APIs.settings</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="APIs template.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>APIs template.settings</DependentUpon>
    </Compile>
    <Compile Update="Properties\permissions.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Permissions.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="APIs.settings">
      <LastGenOutput>APIs.Designer.cs</LastGenOutput>
      <Generator>SettingsSingleFileGenerator</Generator>
    </None>
    <None Update="APIs template.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>APIs template.Designer.cs</LastGenOutput>
    </None>
    <None Update="Properties\APIs.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>APIs.Designer.cs</LastGenOutput>
    </None>
    <None Update="Properties\Permissions.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>permissions.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
